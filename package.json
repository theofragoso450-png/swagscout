{
  "name": "swagscout",
  "version": "0.1.0",
  "description": "Self-hosted archive-fashion deal bot: polls Yahoo Auctions JP, Mercari JP, Rakuma, Grailed and eBay, detects underpriced listings, alerts Discord with proxy-buy links.",
  "type": "module",
  "engines": {
    "node": ">=23"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "smoke": "tsx src/smoke.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke:drift": "tsx src/smoke-drift.ts",
    "watch:fuzzy": "tsx src/watch-fuzzy.ts"
  },
  "dependencies": {
    "cheerio": "^1.0.0",
    "discord.js": "^14.16.3",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.1",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "playwright-core": "^1.49.1",
    "undici": "^8.10.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^4.1.11"
  },
  "allowScripts": {
    "esbuild": true
  }
}
