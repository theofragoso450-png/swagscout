[TEMPLATE]
# ── Required ────────────────────────────────────────────────────────────────
# Discord bot token (create app at discord.com/developers → Bot → Reset Token)
DISCORD_TOKEN=your-discord-bot-token

# ── Recommended ─────────────────────────────────────────────────────────────
# eBay official Browse API. Free key at developer.ebay.com (OAuth2 app id/secret).
# Without it the eBay adapter stays disabled but everything else works.
EBAY_APP_ID=your-app-id-here
EBAY_CERT_ID=your-cert-id-here

# Optional: Discord webhook URL as a simpler alternative to a full bot.
# If DISCORD_TOKEN is set, the bot (slash commands + alerts) is used;
# webhook-only mode sends alerts but no slash commands.
DISCORD_WEBHOOK_URL=

# Comma-separated Discord channel IDs the bot may post alerts into.
# If omitted, the bot posts alerts to every channel it can see (not recommended).
DISCORD_ALLOWED_CHANNELS=

# Daily finds digest: local hour (0-23) to post the top-10 finds of the last
# 24h to subscribed channels. Unset = disabled. Suggested: 8 (morning JST).
DIGEST_HOUR_JST=8

# ── Tuning (all optional, sane defaults) ────────────────────────────────────
# Comma-separated watch keys (brand aliases). Empty = curated default list
# (CDG, Yohji, Number (N)ine, Issey, Raf, Undercover, Bape, Evisu, Supreme, + more).
SWAGSCOUT_WATCH=

# Base polling intervals in seconds per market (jitter is added on top)
POLL_YAHOO=30
POLL_GRAILED=45
POLL_EBAY=60
POLL_MERCARI=90
POLL_RAKUMA=90

# Rounding target for cross-market comp grouping (default 50 USD)
COMP_ROUND_USD=50

# Requests per minute cap per market (politeness)
RATE_LIMIT_RPM=12

# Playwright executable path for the headless-browser fallbacks (optional);
# auto-detects installed Chrome/Edge when empty
PLAYWRIGHT_EXECUTABLE_PATH=

# Optional proxy for browser-based markets (Grailed is Cloudflare IP-sensitive
# and may need a residential proxy from datacenter IPs), e.g.:
# BROWSER_PROXY=http://user:pass@proxy-host:port
BROWSER_PROXY=

# Log level (debug|info|warn|error)
LOG_LEVEL=info

# Dashboard port
PORT=3080
